{
  "name": "gg-stats",
  "version": "1.1.0",
  "private": true,
  "description": "Post game stats for StarCraft, from your replays.",
  "keywords": [
    "brood war",
    "starcraft",
    "replays",
    "stats"
  ],
  "license": "MIT",
  "author": "GG Stats",
  "main": "index.js",
  "engines": {
    "node": ">= 24.0.0"
  },
  "scripts": {
    "app": "pnpm run build-app-main && GGSTATS_HOT=1 electron app",
    "build-app-main": "NODE_ENV=development rolldown -c rolldown.app.config.ts",
    "build-app-client": "vite build -c vite.electron.config.ts && rolldown -c rolldown.app.config.ts",
    "build-game": "cmd /c \"game\\build.bat release x86\" && cmd /c \"game\\build.bat release x86_64\"",
    "check-circular": "madge --circular --extensions ts,tsx,js,jsx --exclude \"/dist/\" ./app ./client",
    "check-orphans": "madge --orphans --extensions ts,tsx,js,jsx --exclude \"/dist/|[.]test[.]|/testing/\" ./app ./client",
    "clean": "rimraf app/dist",
    "dev": "vite -c vite.electron.config.ts",
    "dist": "pnpm run clean && pnpm run build-app-client && pnpm run build-game && pnpm run gen-notices && electron-builder build --win --x64 -p never -c gg-stats.yml",
    "download-fonts": "node -r @swc-node/register download-fonts.ts",
    "format": "oxfmt \"**/*.{js,jsx,mjs,cjs,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,mjs,cjs,ts,tsx}\"",
    "gen-notices": "node -r @swc-node/register tools/notices/gen-notices.ts",
    "gen-translations": "i18next-cli extract --sync-primary",
    "i18n": "node -r @swc-node/register tools/i18n-translate.ts",
    "installall": "cd app && pnpm install && cd .. && pnpm install && electron-builder install-app-deps",
    "lint": "oxlint && pnpm run format:check",
    "lint:fix": "oxlint --fix && pnpm run format",
    "local-dev": "run-pty local-dev.json",
    "release": "node -r @swc-node/register tools/release.ts",
    "pack": "pnpm run clean && pnpm run build-app-client && pnpm run build-game && pnpm run gen-notices && electron-builder build --dir --win --x64 -c gg-stats.yml",
    "test": "vitest",
    "test-ui": "pnpm test --ui --coverage.enabled=true",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    ">0.2%",
    "not ie 11",
    "not ie_mob 11",
    "not op_mini all",
    "not and_uc > 0",
    "not and_qq > 0",
    "not kaios > 0",
    "not ios_saf < 15",
    "not safari < 15",
    "not android < 120"
  ],
  "dependencies": {
    "@shieldbattery/broodrep": "^0.5.0",
    "core-js": "^3.50.0",
    "immer": "^11.1.18",
    "nanoid": "^6.0.1",
    "rimraf": "^6.1.3",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@redux-devtools/core": "^5.0.0",
    "@redux-devtools/dock-monitor": "^5.0.0",
    "@redux-devtools/inspector-monitor": "^7.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.16.1",
    "electron-is-dev": "^3.0.1",
    "eslint": "^10.10.0",
    "google-fonts-helper": "^3.7.4",
    "happy-dom": "^20.14.5",
    "i18next": "^26.4.2",
    "i18next-cli": "1.74.1",
    "i18next-http-backend": "^4.0.2",
    "jotai": "^2.20.3",
    "jotai-devtools": "^0.14.0",
    "jotai-immer": "^0.4.3",
    "jotai-rolldown": "0.2.0",
    "keycode": "^2.2.1",
    "lodash-es": "^4.18.1",
    "madge": "^8.0.0",
    "mkdirp": "^3.0.1",
    "motion": "^13.4.0",
    "oxc-transform-react": "0.151.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "^7.0.2001",
    "polished": "^4.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-redux": "^9.3.0",
    "react-virtuoso": "^4.18.13",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "rolldown": "^1.2.9",
    "run-pty": "^6.0.2",
    "styled-components": "^6.5.3",
    "ts-proto": "^2.12.4",
    "type-fest": "^5.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "^5.0.1",
    "wouter": "^3.11.0",
    "ws": "^8.21.3"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
